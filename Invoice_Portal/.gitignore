# Build artifacts — regenerated by build_exe.py / GitHub Actions each run,
# not something to version-control. The compiled app is distributed via
# GitHub Actions' build artifact download, not the repo itself.
dist/
build/
__pycache__/
*.pyc

# PyInstaller auto-generates/overwrites this every time build_exe.py runs
*.spec

# Contains a GitHub personal access token — never commit this. Created
# automatically on first run; each machine keeps its own local copy.
update_config.json

# Local build environment, if you followed the venv/conda setup
build_env/
venv/

# macOS Finder junk
.DS_Store